# syntax=docker/dockerfile:1.7

FROM rust:1-bookworm AS chef
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*

# Pin the build helper independently of application dependencies.
RUN cargo install cargo-chef --version 0.1.73 --locked

FROM chef AS planner

# Contracts are an immutable build input. Source-only edits reuse this verified
# layer; a changed release manifest, archive, checksum, or preparer invalidates it.
COPY release-compatibility-manifest.json ./
COPY scripts/prepare-vendored-contracts-rust.sh ./scripts/prepare-vendored-contracts-rust.sh
COPY scripts/sync-directory.py ./scripts/sync-directory.py
COPY vendor ./vendor
RUN scripts/prepare-vendored-contracts-rust.sh

# Keep the release build inputs scoped to Rust and contract sources. Unrelated
# CI scripts and Makefile edits must not invalidate the compiled runtime layer.
COPY Cargo.toml Cargo.lock ./
COPY api-server ./api-server
COPY ai-gateway ./ai-gateway
COPY iot-gateway ./iot-gateway
COPY lumiere-codegen ./lumiere-codegen
COPY crates ./crates

# The recipe contains manifests, lockfile, target layout and Cargo configuration,
# not implementation bodies. Source-only changes leave this layer reusable.
RUN cargo chef prepare --recipe-path /app/recipe.json

FROM chef AS builder
ARG CARGO_BUILD_JOBS=1
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
COPY --from=planner /app/recipe.json ./recipe.json
RUN cargo chef cook --locked --release --recipe-path recipe.json \
      -p api-server \
      --bin api-server \
      --bin expense-integration-worker \
      --bin hr-integration-worker \
      --bin owner-report-worker \
      --bin projection-worker \
      --bin project-integration-worker \
      --bin storage-migrate \
      --bin workflow-worker \
    && cargo chef cook --locked --release --recipe-path recipe.json \
      -p ai-gateway --bin gateway

# Replace every dummy local package with real sources, including the verified
# contracts and generated bindings consumed by api-server/build.rs. cargo-chef
# removes dummy local compilation artifacts; no stub is shipped or executed.
COPY release-compatibility-manifest.json ./
COPY scripts/prepare-vendored-contracts-rust.sh ./scripts/prepare-vendored-contracts-rust.sh
COPY scripts/sync-directory.py ./scripts/sync-directory.py
COPY vendor ./vendor
RUN scripts/prepare-vendored-contracts-rust.sh
COPY Cargo.toml Cargo.lock ./
COPY api-server ./api-server
COPY ai-gateway ./ai-gateway
COPY iot-gateway ./iot-gateway
COPY lumiere-codegen ./lumiere-codegen
COPY crates ./crates

# Build the production runtime set once. Keep the package builds separate because
# Cargo's --bin filters apply to each selected package.
RUN cargo build --locked --release --jobs "${CARGO_BUILD_JOBS}" \
      -p api-server \
      --bin api-server \
      --bin expense-integration-worker \
      --bin hr-integration-worker \
      --bin owner-report-worker \
      --bin projection-worker \
      --bin project-integration-worker \
      --bin storage-migrate \
      --bin workflow-worker \
    && cargo build --locked --release --jobs "${CARGO_BUILD_JOBS}" \
      -p ai-gateway --bin gateway \
    && install -d /out \
    && install -m 0755 \
      target/release/api-server \
      target/release/expense-integration-worker \
      target/release/gateway \
      target/release/hr-integration-worker \
      target/release/owner-report-worker \
      target/release/projection-worker \
      target/release/project-integration-worker \
      target/release/storage-migrate \
      target/release/workflow-worker \
      /out/

FROM debian:bookworm-slim AS runtime
ENV RUST_LOG=info

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/ /usr/local/bin/
COPY --chmod=0755 scripts/lumiere-runtime-entrypoint.sh /usr/local/bin/lumiere-runtime-entrypoint

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/lumiere-runtime-entrypoint"]
