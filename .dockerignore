# Keep Docker build contexts small. In particular, do not send local Rust and
# JavaScript build caches to OrbStack; they can be tens of gigabytes and are
# architecture-specific.
.git
.gitignore
.DS_Store
.env
.env.*
!.env.example
!.env.docker.example
**/target
**/node_modules
**/.next
**/.turbo
**/dist
**/coverage
**/playwright-report
**/test-results
.tmp
.vscode
