# Server
PORT=8080
LUMIERE_AI_GATEWAY_INTERNAL_SECRET=change-me
LUMIERE_API_SERVER_URL=http://localhost:8082

# Qdrant (self-hosted or Qdrant Cloud)
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=lumiere_embeddings_org_v3
QDRANT_ACTIVITY_REFS_COLLECTION=lumiere_erp_activity_refs_v1

# Unified embedding provider for all Qdrant indexing: ollama | mistral | gemini
# Set disabled for a chat-only pilot; no collections or queue jobs are changed.
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=gemma4:e2b-mlx
OLLAMA_VISION_MODEL=llava
# Opt-in: let Ollama-provider agents use tool-calling roles (Decision/Reasoning/
# Review) instead of the legacy single-shot-only path. Off by default — only
# enable for a model you've confirmed supports native tool calling (e.g.
# `gemma4`, `llama3.1`+), never blindly for whatever OLLAMA_LLM_MODEL is set.
OLLAMA_SUPPORTS_TOOL_CALLING=false

# Cloud provider keys (server-only). Chat provider/model selection lives in
# AiAgent + versioned model profiles/intelligence policies, not EMBEDDING_PROVIDER.
# Mistral setup and remaining gates: docs/plans/mistral-harness-readiness.md
MISTRAL_API_KEY=
# Optional reasoning controls; blank preserves provider defaults. Effort accepts
# none or high and requires exact account-visible IDs in the capability allowlist.
# Example: MISTRAL_REASONING_MODELS=mistral-large-4 (or mistral-large-4-0 if listed
# by your account), MISTRAL_REASONING_EFFORT=high. No wildcard/model inference.
# Models alone opt into request-level controls without a transport default.
MISTRAL_REASONING_EFFORT=
MISTRAL_REASONING_MODELS=
GOOGLE_API_KEY=

# Optional: route LLM chat via Kong AI Gateway (OpenAI-compatible internal route)
KONG_LLM_URL=
KONG_LLM_SERVICE_TOKEN=
# Optional exact, non-generative Kong endpoint used only by /health/ready
KONG_LLM_READINESS_URL=

# Vision / document parsing
# Set disabled to reject OCR without a provider call.
VISION_PROVIDER=ollama
DOCUMENT_PARSER=plaintext
UNSTRUCTURED_URL=http://localhost:8000

# SpacetimeDB connection
STDB_HOST=http://127.0.0.1:3000
STDB_MODULE=lumiere-v1
STDB_TOKEN=your-stdb-token-here
# Admitted governed runs require a server-only envelope signing key (>=32 bytes)
# and a distinct, registered ai_spend_reader service identity.
AI_EXECUTION_ENVELOPE_KEY=
AI_SPEND_READ_STDB_TOKEN=
# Production also requires a distinct certification executor and its SHA-256
# runtime fingerprint. Configure both together; leave both blank for local dev.
AI_CERTIFICATION_STDB_TOKEN=
AI_CERTIFICATION_RUNTIME_HASH=

# Queue worker
WORKER_POLL_SECS=10
WORKER_BATCH_SIZE=20
