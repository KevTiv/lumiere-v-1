# SpacetimeDB / Lumiere API (server-side Next.js + Rust api-server)
#
# HTTP: Next `/api/*` routes forward to `LUMIERE_API_SERVER_URL` (see `lib/api-server-forward.ts`).
# See also: docs/ENVIRONMENT.md

# Rust api-server base (no trailing slash). Used by Next route forwarding and the realtime WS proxy.
# Development defaults to http://127.0.0.1:8082 when unset. Production: set explicitly.
LUMIERE_API_SERVER_URL=http://127.0.0.1:8082

# Optional: browser calls Rust `/v1/*` directly (`/api/query`→`/v1/query`, etc.).
# Leaving unset keeps same-origin `/api/*` (no browser CORS). If set to `http://localhost:8082`
# while the app is opened as `http://127.0.0.1:…`, the browser treats it as cross-origin — set
# `CORS_ORIGINS` on api-server or match hostnames (`127.0.0.1` everywhere). Defaults now include
# http://127.0.0.1:3100 for Playwright + `next start`.
# NEXT_PUBLIC_API_GATEWAY_URL=http://127.0.0.1:8082

# Optional: browser connects directly to this WebSocket URL (skip same-origin proxy). Example:
# NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:8082/v1/realtime/ws
# Optional: reverse-proxy api-server on the same host as the web app:
# NEXT_PUBLIC_REALTIME_SAME_ORIGIN=1

# SpacetimeDB module/database name — must match `spacetime publish <name>` (see Makefile STDB_MODULE).
STDB_MODULE=lumiere-v1-j1uo0
NEXT_PUBLIC_STDB_MODULE=lumiere-v1-j1uo0

# Optional: override maincloud default (server + scripts). Use http(s) or ws(s); normalized to HTTP for SQL.
# STDB_HOST=https://maincloud.spacetimedb.com
# NEXT_PUBLIC_STDB_HOST=wss://maincloud.spacetimedb.com

# Server token for authenticated HTTP queries (admin/service account)
# Used for server-side SQL (stdbSql) and calling auth reducers (store_user_credential, etc.).
# Must match an identity that is a superuser in SpacetimeDB (see module auth reducers).
STDB_SERVER_TOKEN=your-server-token-here

# AES-GCM key for encrypting SpacetimeDB tokens stored in user_credential (32 bytes = 64 hex chars)
STDB_CREDENTIAL_ENCRYPTION_KEY=

# ── Email/password auth (default when WorkOS is not configured) ─────────────
# Leave WorkOS variables unset to use built-in sign-up / sign-in API routes
# (see app/api/auth/signup, signin, forgot-password, reset-password).
#
# Optional: set COOKIE_FORCE_SECURE=true on HTTPS staging where NODE_ENV is not production.
# COOKIE_FORCE_SECURE=true
#
# Optional: disable in-memory auth rate limits (e.g. local E2E tests)
# AUTH_RATE_LIMIT_DISABLED=true

# ── WorkOS / SSO (optional — enable when you need enterprise IdP) ────────────
# When WORKOS_CLIENT_ID is set, password routes return 410 and the UI uses AuthKit.
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_COOKIE_PASSWORD=
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# Development: Set this to bypass auth and use a specific org ID
# DEV_MOCK_ORG_ID=1

# The browser does not open a raw SpacetimeDB SDK WebSocket to maincloud from the web app;
# realtime updates use the Lumiere JSON WebSocket to api-server instead.

# ── PostHog (optional locally — omit to disable analytics) ─────────────────
# Project API key: https://eu.posthog.com/settings/project (or your region)
# NEXT_PUBLIC_POSTHOG_TOKEN=phc_xxx
# Ingestion API (must match reverse-proxy rewrites in next.config.mjs)
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional: asset CDN when not using EU/US defaults
# NEXT_PUBLIC_POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
# PostHog web app (toolbar / session replay links)
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
# Optional server-only overrides (otherwise same as NEXT_PUBLIC_*)
# POSTHOG_KEY=
# POSTHOG_HOST=

# AI memory / RAG (Next BFF → ai-gateway) — server only
# LUMIERE_AI_GATEWAY_URL=http://localhost:3001
# LUMIERE_AI_GATEWAY_INTERNAL_SECRET=
