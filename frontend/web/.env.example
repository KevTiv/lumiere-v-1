# SpacetimeDB Configuration (Server-only - NEVER exposed to browser)
# These variables are used only on the server side for Phase 0 WebSocket proxy
# The browser connects to /api/stdb which proxies to the real SpacetimeDB host

# SpacetimeDB WebSocket host (e.g., wss://maincloud.spacetimedb.com)
STDB_HOST=wss://maincloud.spacetimedb.com

# SpacetimeDB module/database name
STDB_MODULE=lumiere-v1

# Server token for authenticated HTTP queries (admin/service account)
# This token is used for server-side SQL queries via stdbSql
STDB_SERVER_TOKEN=your-server-token-here

# Development: Set this to bypass auth and use a specific org ID
# DEV_MOCK_ORG_ID=1

# NOTE: We no longer use NEXT_PUBLIC_STDB_HOST or NEXT_PUBLIC_STDB_MODULE
# The browser never sees the real SpacetimeDB host - it connects through
# the Next.js WebSocket proxy at /api/stdb
