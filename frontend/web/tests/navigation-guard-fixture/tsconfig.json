{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ui/*": [
        "../../../packages/ui/src/components/*"
      ],
      "@/components/*": [
        "../../../packages/ui/src/*"
      ],
      "@/lib/*": [
        "../../lib/*",
        "../../../packages/ui/src/lib/*"
      ],
      "@/hooks/*": [
        "../../hooks/*",
        "../../../packages/ui/src/hooks/*"
      ],
      "@lumiere/ui": [
        "../../../packages/ui/src/index.ts"
      ],
      "@lumiere/ui/*": [
        "../../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
