{
  "name": "@lumiere/presentation-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./module-contract": "./src/generated/module-draft.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:contract": "node scripts/generate-module-contract.mjs",
    "check:contract": "node scripts/generate-module-contract.mjs --check",
    "check:contract-types": "node scripts/generate-module-contract.mjs --from-schema --check",
    "test": "node --import tsx --test src/index.test.ts"
  },
  "devDependencies": { "@types/node": "^22.10.0", "json-schema-to-typescript": "15.0.4", "tsx": "^4.20.5", "typescript": "^5.5.0" }
}
