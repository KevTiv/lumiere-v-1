# syntax=docker/dockerfile:1

FROM node:26-bookworm-slim AS node-runtime

FROM mcr.microsoft.com/playwright:v1.60.0-noble

# Keep Playwright's browser libraries while using the same Node major as CI.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
RUN npm install --global pnpm@10.31.0

WORKDIR /workspace/frontend

COPY . .

RUN --mount=type=cache,id=lumiere-e2e-pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

ENTRYPOINT ["pnpm", "--dir", "web", "exec", "playwright", "test"]
