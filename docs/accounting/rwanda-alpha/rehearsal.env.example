# Copy to a temporary file outside version control and fill every value.
# Never put credentials or customer data in this file.
PLAYWRIGHT_BASE_URL=https://isolated-rehearsal.example.invalid
E2E_RWANDA_ALPHA_REHEARSAL=1
E2E_RWANDA_REQUIRE_ACCEPTED_PACK=0
E2E_RWANDA_ISOLATED_TENANT_ACK=1
E2E_RWANDA_RUN_ID=rw-alpha-YYYYMMDD-01
E2E_RWANDA_TENANT_REF=isolated-tenant-reference
E2E_RWANDA_EXPECTED_COMPANY_ID=123
E2E_RWANDA_OPERATOR_NAME=operator-name
E2E_RWANDA_OPERATOR_EMAIL=operator@example.invalid
E2E_RWANDA_RELEASE_COMMIT=0000000000000000000000000000000000000000
E2E_RWANDA_CONTRACT_VERSION=0.0.0
E2E_RWANDA_MODULE_VERSION=module-release-or-wasm-digest
E2E_RWANDA_CUTOVER_DATE=YYYY-MM-DD
# Use the exact partners selected when the historical customer receipt and
# supplier payment are created. These IDs make the rehearsal deterministic.
E2E_RWANDA_CUSTOMER_PARTNER_ID=234
E2E_RWANDA_SUPPLIER_PARTNER_ID=235
E2E_RWANDA_MIGRATION_MODE=residual_only

# Required only when E2E_RWANDA_MIGRATION_MODE=original_total_with_payment_replay.
# Each ID must reference a posted, unallocated RWF transaction in the rehearsal
# company for the configured partner. Record it with source record type
# historical_accounting_import, a positive numeric operator-assigned batch
# reference (a grouping marker, not a verified foreign key), and an occurred-at
# date no later than E2E_RWANDA_CUTOVER_DATE. The customer receipt
# must be inbound/customer and settle 200000 RWF. The supplier payment must be
# outbound/supplier and settle 200000 RWF. Posting must create a paid ledger
# payment and a posted payment move whose remaining residual is the full
# settlement amount. The run fails closed on any mismatch or prior allocation.
# E2E_RWANDA_CUSTOMER_PAYMENT_TRANSACTION_ID=456
# E2E_RWANDA_SUPPLIER_PAYMENT_TRANSACTION_ID=457
