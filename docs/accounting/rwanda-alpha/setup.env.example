# Load this file only in a private one-shot Railway job. Keep it outside Git after filling it.
# Passwords and STDB_SERVER_TOKEN must come from secret references, never this file.
LUMIERE_API_SERVER_URL=http://api-server.railway.internal:8082
STDB_HOST=http://spacetimedb.railway.internal:3000
STDB_MODULE=isolated-rwanda-rehearsal-module

RWANDA_SETUP_ISOLATED_TENANT_ACK=1
RWANDA_SETUP_TENANT_REF=isolated-rwanda-rehearsal-reference
RWANDA_SETUP_ORG_NAME=Rwanda accounting rehearsal
RWANDA_SETUP_ORG_CODE=RWALPHA
RWANDA_SETUP_OWNER_EMAIL=rw.alpha.owner@example.test
RWANDA_SETUP_OPERATOR_EMAIL=rw.alpha.operator@example.test
RWANDA_SETUP_BOOKKEEPER_EMAIL=rw.alpha.bookkeeper@example.test
# The companion reconciliation specs currently require this exact reader address.
RWANDA_SETUP_READER_EMAIL=fixture.reader@example.test
RWANDA_SETUP_CUTOVER_DATE=YYYY-MM-DD

# Secret references required by the setup process:
# STDB_SERVER_TOKEN
# RWANDA_SETUP_OWNER_PASSWORD
# RWANDA_SETUP_PERSONA_PASSWORD
