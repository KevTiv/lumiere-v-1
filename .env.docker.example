# Copy to .env.docker. This file stays local because it contains credentials.
#
# `make init-stack` creates .env.docker from this file, generates the gateway
# secret, publishes the local module, and fills both token values.

STDB_MODULE=lumiere-v1
STDB_SERVER_TOKEN=replace-with-local-owner-token
STDB_TOKEN=replace-with-local-owner-token
LUMIERE_AI_GATEWAY_INTERNAL_SECRET=local-dev-only-change-me

# Optional in local development. Set both to enable the server-owned
# certification worker; the token must resolve to a dedicated executor identity.
AI_CERTIFICATION_STDB_TOKEN=
AI_CERTIFICATION_RUNTIME_HASH=
AI_CERTIFICATION_POLL_SECS=5
AI_CERTIFICATION_BATCH_SIZE=10
AI_CERTIFICATION_TIMEOUT_SECS=30

# Scheduled typed owner-report delivery. PDFs are rendered internally and
# retained on the shared owner-report artifact volume.
LUMIERE_OWNER_REPORT_WORKER_POLL_SECS=5
LUMIERE_OWNER_REPORT_WORKER_NAME=owner-report-worker-dev

# Enables authenticated API work without a browser session. Leave blank to
# exercise the regular sign-in flow.
DEV_MOCK_ORG_ID=1

# Requires a local Ollama instance unless changed to a configured cloud provider.
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2
