# IoT Gateway Configuration

# HTTP server port (default: 8081)
PORT=8081

# SpacetimeDB connection (HTTP API — optional NEXT_PUBLIC_STDB_HOST for wss URLs)
STDB_HOST=http://127.0.0.1:3000
STDB_MODULE=lumiere-v1-j1uo0
# Dedicated identity registered as `iot_gateway` for every organization served.
STDB_IOT_GATEWAY_TOKEN=your_dedicated_iot_gateway_token_here

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=lumiere-iot-gateway
# MQTT_USERNAME=user      # optional
# MQTT_PASSWORD=password  # optional

# Action dispatcher poll interval (seconds, default: 5)
ACTION_POLL_SECS=5
