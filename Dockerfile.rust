# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS chef
WORKDIR /app

FROM chef AS builder
ARG BIN
ARG CARGO_BUILD_JOBS=1
COPY Cargo.toml Cargo.lock ./
COPY Makefile ./
COPY release-compatibility-manifest.json ./
COPY scripts ./scripts
COPY vendor ./vendor
COPY api-server ./api-server
COPY ai-gateway ./ai-gateway
COPY iot-gateway ./iot-gateway
COPY lumiere-codegen ./lumiere-codegen
COPY crates ./crates
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 \
  && rm -rf /var/lib/apt/lists/*
RUN scripts/prepare-vendored-contracts-rust.sh
RUN cargo build --locked --release --jobs "${CARGO_BUILD_JOBS}" --bin "${BIN}"

FROM debian:bookworm-slim AS runtime
ARG BIN
ENV RUST_LOG=info
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder "/app/target/release/${BIN}" /usr/local/bin/lumiere-service
EXPOSE 8080
CMD ["/usr/local/bin/lumiere-service"]
